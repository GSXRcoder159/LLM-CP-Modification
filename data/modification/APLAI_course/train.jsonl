// {"APLAI_EX5S2_constraint_addition_complex": {"question": "We want to climb a stair of n steps with [m1, m2] steps at a time. For example a stair of 4 steps with m1 = 1, and m2 = 2 can be climbed with a sequence of four one-step moves or with two two-steps moves. Find a way to climb a stair of 20 steps with m1 = 3 and m2 = 5, i.e. you can take only 3 or 4 or 5 steps at a time.","existing_model": "```\nfrom cpmpy import *\nimport json\n\n# Parameters\nn = 20  # total number of steps in the stair\nm1, m2 = 3, 5  # number of steps that can be taken at a time\n\n# Decision variables\nsteps = intvar(0, m2, shape=n) # steps taken at each move\n\n# Model setup\nm = Model()\n\n# Constraint: the sum of steps should equal the total number of stairs\nm += sum(steps) == n\n\n# Constraint: the number of steps taken at each move should be between m1 and m2 or 0\nm += [(steps[i] >= m1) | (steps[i] == 0) for i in range(n)]\nm += [steps[i] <= m2 for i in range(n)]\n\n# Trailing zeros: If a step is 0, then all the following steps should be 0\nfor i in range(1, n):\n    m += (steps[i - 1] == 0).implies(all(steps[j] == 0 for j in range(i, n)))\n\n# Solve the model and print the results in the required format\nif m.solve():\n    solution = {\"steps\": [steps[i].value() for i in range(n) if steps[i].value() != 0]}\n    print(json.dumps(solution))\n```","modification_request": "Add a constraint enforcing that the sequence of non-zero steps is non-decreasing (each subsequent non-zero step must be at least as large as the previous one).","modified_cpmpy_code": "```\nfrom cpmpy import *\nimport json\n\n# Parameters\nn = 20  # total number of steps in the stair\nm1, m2 = 3, 5  # number of steps that can be taken at a time\n\n# Decision variables\nsteps = intvar(0, m2, shape=n) # steps taken at each move\n\n# Model setup\nm = Model()\n\n# Constraint: the sum of steps should equal the total number of stairs\nm += sum(steps) == n\n\n# Constraint: the number of steps taken at each move should be between m1 and m2 or 0\nm += [(steps[i] >= m1) | (steps[i] == 0) for i in range(n)]\nm += [steps[i] <= m2 for i in range(n)]\n\n# Trailing zeros: If a step is 0, then all the following steps should be 0\nfor i in range(1, n):\n    m += (steps[i - 1] == 0).implies(all(steps[j] == 0 for j in range(i, n)))\n\n# Constraint: non-decreasing non-zero steps\nfor i in range(1, n):\n    m += ((steps[i-1] != 0) & (steps[i] != 0)).implies(steps[i] >= steps[i-1])  # added complex constraint\n\n# Solve the model and print the results in the required format\nif m.solve():\n    solution = {\"steps\": [steps[i].value() for i in range(n) if steps[i].value() != 0]}\n    print(json.dumps(solution))\n```"}}
// {"APLAI_EX5S2_constraint_addition_moderate": {"question": "We want to climb a stair of n steps with [m1, m2] steps at a time. For example a stair of 4 steps with m1 = 1, and m2 = 2 can be climbed with a sequence of four one-step moves or with two two-steps moves. Find a way to climb a stair of 20 steps with m1 = 3 and m2 = 5, i.e. you can take only 3 or 4 or 5 steps at a time.","existing_model": "```\nfrom cpmpy import *\nimport json\n\n# Parameters\nn = 20  # total number of steps in the stair\nm1, m2 = 3, 5  # number of steps that can be taken at a time\n\n# Decision variables\nsteps = intvar(0, m2, shape=n) # steps taken at each move\n\n# Model setup\nm = Model()\n\n# Constraint: the sum of steps should equal the total number of stairs\nm += sum(steps) == n\n\n# Constraint: the number of steps taken at each move should be between m1 and m2 or 0\nm += [(steps[i] >= m1) | (steps[i] == 0) for i in range(n)]\nm += [steps[i] <= m2 for i in range(n)]\n\n# Trailing zeros: If a step is 0, then all the following steps should be 0\nfor i in range(1, n):\n    m += (steps[i - 1] == 0).implies(all(steps[j] == 0 for j in range(i, n)))\n\n# Solve the model and print the results in the required format\nif m.solve():\n    solution = {\"steps\": [steps[i].value() for i in range(n) if steps[i].value() != 0]}\n    print(json.dumps(solution))\n```","modification_request": "Add a constraint to forbid any two consecutive non-zero moves from having the same step size.","modified_cpmpy_code": "```\nfrom cpmpy import *\nimport json\n\n# Parameters\nn = 20  # total number of steps in the stair\nm1, m2 = 3, 5  # number of steps that can be taken at a time\n\n# Decision variables\nsteps = intvar(0, m2, shape=n) # steps taken at each move\n\n# Model setup\nm = Model()\n\n# Constraint: the sum of steps should equal the total number of stairs\nm += sum(steps) == n\n\n# Constraint: the number of steps taken at each move should be between m1 and m2 or 0\nm += [(steps[i] >= m1) | (steps[i] == 0) for i in range(n)]\nm += [steps[i] <= m2 for i in range(n)]\n\n# Trailing zeros: If a step is 0, then all the following steps should be 0\nfor i in range(1, n):\n    m += (steps[i - 1] == 0).implies(all(steps[j] == 0 for j in range(i, n)))\n\n# Constraint: no two consecutive non-zero moves have the same size\nfor i in range(1, n):\n    m += (steps[i] != 0).implies(steps[i] != steps[i-1])  # added constraint\n\n# Solve the model and print the results in the required format\nif m.solve():\n    solution = {\"steps\": [steps[i].value() for i in range(n) if steps[i].value() != 0]}\n    print(json.dumps(solution))\n```"}}
// {"APLAI_EX5S2_constraint_addition_easy": {"question": "We want to climb a stair of n steps with [m1, m2] steps at a time. For example a stair of 4 steps with m1 = 1, and m2 = 2 can be climbed with a sequence of four one-step moves or with two two-steps moves. Find a way to climb a stair of 20 steps with m1 = 3 and m2 = 5, i.e. you can take only 3 or 4 or 5 steps at a time.","existing_model": "```\nfrom cpmpy import *\nimport json\n\n# Parameters\nn = 20  # total number of steps in the stair\nm1, m2 = 3, 5  # number of steps that can be taken at a time\n\n# Decision variables\n# In the worst case, we take all steps one at a time, so we have 'n' decision variables\nsteps = intvar(0, m2, shape=n) # steps taken at each move\n\n# Model setup\nm = Model()\n\n# Constraint: the sum of steps should equal the total number of stairs\nm += sum(steps) == n\n\n# Constraint: the number of steps taken at each move should be between m1 and m2 or 0\nm += [(steps[i] >= m1) | (steps[i] == 0) for i in range(n)]\nm += [steps[i] <= m2 for i in range(n)]\n\n# Trailing zeros: If a step is 0, then all the following steps should be 0\nfor i in range(1, n):\n    m += (steps[i - 1] == 0).implies(all(steps[j] == 0 for j in range(i, n)))\n\n# Solve the model and print the results in the required format\nif m.solve():\n    solution = {\"steps\": [steps[i].value() for i in range(n) if steps[i].value() != 0]}\n    print(json.dumps(solution))\n```","modification_request": "Add a constraint that ensures at least one 5-step move (i.e., a move of length m2) is used in the solution.","modified_cpmpy_code": "```\nfrom cpmpy import *\nimport json\n\n# Parameters\nn = 20  # total number of steps in the stair\nm1, m2 = 3, 5  # number of steps that can be taken at a time\n\n# Decision variables\nsteps = intvar(0, m2, shape=n) # steps taken at each move\n\n# Model setup\nm = Model()\n\n# Constraint: the sum of steps should equal the total number of stairs\nm += sum(steps) == n\n\n# Constraint: the number of steps taken at each move should be between m1 and m2 or 0\nm += [(steps[i] >= m1) | (steps[i] == 0) for i in range(n)]\nm += [steps[i] <= m2 for i in range(n)]\n\n# Trailing zeros: If a step is 0, then all the following steps should be 0\nfor i in range(1, n):\n    m += (steps[i - 1] == 0).implies(all(steps[j] == 0 for j in range(i, n)))\n\n# Constraint: at least one 5-step move must be used\nm += sum(steps[i] == m2 for i in range(n)) >= 1  # added constraint\n\n# Solve the model and print the results in the required format\nif m.solve():\n    solution = {\"steps\": [steps[i].value() for i in range(n) if steps[i].value() != 0]}\n    print(json.dumps(solution))\n```"}}

// {"APLAI_EX3S1_1": {"question": "In preparation for Passover, five children at Hebrew school (Bernice, Carl, Debby, Sammy, and Ted) have been chosen to present different parts of the story of the Exodus from Egypt (burning bush, captivity, Moses's youth, Passover, or the Ten Commandments). Each child is a different age (three, five, seven, eight, or ten), and the family of each child has recently made its own exodus to America from a different country (Ethiopia, Kazakhstan, Lithuania, Morocco, or Yemen). Can you find the age of each child, his or her family's country of origin, and the part of the Exodus story each related? 1. Debby's family is from Lithuania. 2. The child who told the story of the Passover is two years older than Bernice. 3. The child whose family is from Yemen is younger than the child from the Ethiopian family. 4. The child from the Moroccan family is three years older than Ted. 5. Sammy is three years older than the child who told the story of Moses's youth in the house of the Pharaoh. Determine the association: Age-Child-Country-Story.","existing_model": "from cpmpy import *\nimport json\n\n# Decision variables\nage3, age5, age7, age8, age10 = ages = intvar(1, 5, shape=5)\nbernice, carl, debby, sammy, ted = children = intvar(1, 5, shape=5)\nethiopia, kazakhstan, lithuania, morocco, yemen = countries = intvar(1, 5, shape=5)\nburning_bush, captivity, moses_youth, passover, ten_commandments = stories = intvar(1, 5, shape=5)\n\n# Constraints\nm = Model()\nm += AllDifferent(ages)\nm += AllDifferent(children)\nm += AllDifferent(countries)\nm += AllDifferent(stories)\n\nm += debby == lithuania\nage_to_int = {age3:3, age5:5, age7:7, age8:8, age10:10}\nm += [((a1==passover)&(a2==bernice)).implies(age_to_int[a1]==age_to_int[a2]+2) for a1 in ages for a2 in ages]\nm += [((a1==yemen)&(a2==ethiopia)).implies(age_to_int[a1]<age_to_int[a2]) for a1 in ages for a2 in ages]\nm += [((a1==morocco)&(a2==ted)).implies(age_to_int[a1]==age_to_int[a2]+3) for a1 in ages for a2 in ages]\nm += [((a1==sammy)&(a2==moses_youth)).implies(age_to_int[a1]==age_to_int[a2]+3) for a1 in ages for a2 in ages]\n\nif m.solve():\n    sol={\"ages\":ages.value().tolist(),\"children\":children.value().tolist(),\"countries\":countries.value().tolist(),\"stories\":stories.value().tolist()}\n    print(json.dumps(sol))","modification_request": "Add the constraint that Bernice is older than Carl.","modified_cpmpy_code": "from cpmpy import *\nimport json\n\n# Decision variables\nage3, age5, age7, age8, age10 = ages = intvar(1, 5, shape=5)\nbernice, carl, debby, sammy, ted = children = intvar(1, 5, shape=5)\nethiopia, kazakhstan, lithuania, morocco, yemen = countries = intvar(1, 5, shape=5)\nburning_bush, captivity, moses_youth, passover, ten_commandments = stories = intvar(1, 5, shape=5)\n\n# Constraints\nm = Model()\nm += AllDifferent(ages)\nm += AllDifferent(children)\nm += AllDifferent(countries)\nm += AllDifferent(stories)\n\nm += debby == lithuania\nage_to_int = {age3:3, age5:5, age7:7, age8:8, age10:10}\n# existing age relations\nm += [((a1==passover)&(a2==bernice)).implies(age_to_int[a1]==age_to_int[a2]+2) for a1 in ages for a2 in ages]\nm += [((a1==yemen)&(a2==ethiopia)).implies(age_to_int[a1]<age_to_int[a2]) for a1 in ages for a2 in ages]\nm += [((a1==morocco)&(a2==ted)).implies(age_to_int[a1]==age_to_int[a2]+3) for a1 in ages for a2 in ages]\nm += [((a1==sammy)&(a2==moses_youth)).implies(age_to_int[a1]==age_to_int[a2]+3) for a1 in ages for a2 in ages]\n# new constraint\nm += [((a1==bernice)&(a2==carl)).implies(age_to_int[a1]>age_to_int[a2]) for a1 in ages for a2 in ages]\n\nif m.solve():\n    sol={\"ages\":ages.value().tolist(),\"children\":children.value().tolist(),\"countries\":countries.value().tolist(),\"stories\":stories.value().tolist()}\n    print(json.dumps(sol))"}}
// {"APLAI_EX3S1_4": {"question": "In preparation for Passover, five children at Hebrew school (Bernice, Carl, Debby, Sammy, and Ted) have been chosen to present different parts of the story of the Exodus from Egypt (burning bush, captivity, Moses's youth, Passover, or the Ten Commandments). Each child is a different age (three, five, seven, eight, or ten), and the family of each child has recently made its own exodus to America from a different country (Ethiopia, Kazakhstan, Lithuania, Morocco, or Yemen). Can you find the age of each child, his or her family's country of origin, and the part of the Exodus story each related? 1. Debby's family is from Lithuania. 2. The child who told the story of the Passover is two years older than Bernice. 3. The child whose family is from Yemen is younger than the child from the Ethiopian family. 4. The child from the Moroccan family is three years older than Ted. 5. Sammy is three years older than the child who told the story of Moses's youth in the house of the Pharaoh. Determine the association: Age-Child-Country-Story.","existing_model": "from cpmpy import *\nimport json\n\n# Decision variables\nage3, age5, age7, age8, age10 = ages = intvar(1, 5, shape=5)\nbernice, carl, debby, sammy, ted = children = intvar(1, 5, shape=5)\nethiopia, kazakhstan, lithuania, morocco, yemen = countries = intvar(1, 5, shape=5)\nburning_bush, captivity, moses_youth, passover, ten_commandments = stories = intvar(1, 5, shape=5)\n\n# Constraints\nm = Model()\nm += AllDifferent(ages)\nm += AllDifferent(children)\nm += AllDifferent(countries)\nm += AllDifferent(stories)\n\nm += debby == lithuania\nage_to_int = {age3:3, age5:5, age7:7, age8:8, age10:10}\nm += [((a1==passover)&(a2==bernice)).implies(age_to_int[a1]==age_to_int[a2]+2) for a1 in ages for a2 in ages]\nm += [((a1==yemen)&(a2==ethiopia)).implies(age_to_int[a1]<age_to_int[a2]) for a1 in ages for a2 in ages]\nm += [((a1==morocco)&(a2==ted)).implies(age_to_int[a1]==age_to_int[a2]+3) for a1 in ages for a2 in ages]\nm += [((a1==sammy)&(a2==moses_youth)).implies(age_to_int[a1]==age_to_int[a2]+3) for a1 in ages for a2 in ages]\n\nif m.solve():\n    sol={\"ages\":ages.value().tolist(),\"children\":children.value().tolist(),\"countries\":countries.value().tolist(),\"stories\":stories.value().tolist()}\n    print(json.dumps(sol))","modification_request": "Add an objective to minimize the sum of the 'children' variables (i.e. favor lower index assignments).","modified_cpmpy_code": "from cpmpy import *\nimport json\n\nage3, age5, age7, age8, age10 = ages = intvar(1, 5, shape=5)\nbernice, carl, debby, sammy, ted = children = intvar(1, 5, shape=5)\nethiopia, kazakhstan, lithuania, morocco, yemen = countries = intvar(1, 5, shape=5)\nburning_bush, captivity, moses_youth, passover, ten_commandments = stories = intvar(1, 5, shape=5)\n\nm = Model()\nm += AllDifferent(ages)\nm += AllDifferent(children)\nm += AllDifferent(countries)\nm += AllDifferent(stories)\n\nm += debby == lithuania\nage_to_int={age3:3,age5:5,age7:7,age8:8,age10:10}\nm += [((a1==passover)&(a2==bernice)).implies(age_to_int[a1]==age_to_int[a2]+2) for a1 in ages for a2 in ages]\nm += [((a1==yemen)&(a2==ethiopia)).implies(age_to_int[a1]<age_to_int[a2]) for a1 in ages for a2 in ages]\nm += [((a1==morocco)&(a2==ted)).implies(age_to_int[a1]==age_to_int[a2]+3) for a1 in ages for a2 in ages]\nm += [((a1==sammy)&(a2==moses_youth)).implies(age_to_int[a1]==age_to_int[a2]+3) for a1 in ages for a2 in ages]\n# new objective\nm.minimize(sum(children))\n\nif m.solve(): print(json.dumps({\"ages\":ages.value().tolist(),\"children\":children.value().tolist(),\"countries\":countries.value().tolist(),\"stories\":stories.value().tolist()}))"}}
