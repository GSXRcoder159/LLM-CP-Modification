// {"APLAI_EX5S2_objective_change_complex": {"question": "We want to climb a stair of n steps with [m1, m2] steps at a time. For example a stair of 4 steps with m1 = 1, and m2 = 2 can be climbed with a sequence of four one-step moves or with two two-steps moves. Find a way to climb a stair of 20 steps with m1 = 3 and m2 = 5, i.e. you can take only 3 or 4 or 5 steps at a time.","existing_model": "```\nfrom cpmpy import *\nimport json\n\n# Parameters\nn = 20  # total number of steps in the stair\nm1, m2 = 3, 5  # number of steps that can be taken at a time\n\n# Decision variables\nsteps = intvar(0, m2, shape=n) # steps taken at each move\n\n# Model setup\nm = Model()\n\n# Constraint: the sum of steps should equal the total number of stairs\nm += sum(steps) == n\n\n# Constraint: the number of steps taken at each move should be between m1 and m2 or 0\nm += [(steps[i] >= m1) | (steps[i] == 0) for i in range(n)]\nm += [steps[i] <= m2 for i in range(n)]\n\n# Trailing zeros: If a step is 0, then all the following steps should be 0\nfor i in range(1, n):\n    m += (steps[i - 1] == 0).implies(all(steps[j] == 0 for j in range(i, n)))\n\n# Solve the model and print the results in the required format\nif m.solve():\n    solution = {\"steps\": [steps[i].value() for i in range(n) if steps[i].value() != 0]}\n    print(json.dumps(solution))\n```","modification_request": "Add a weighted objective: maximize 10x(number of largest step-size moves) - (number of moves), encouraging many large jumps with few total moves.","modified_cpmpy_code": "```\nfrom cpmpy import *\nimport json\n\n# Parameters\nn = 20\nm1, m2 = 3, 5\n\n# Decision variables\nsteps = intvar(0, m2, shape=n)\n\n# Model setup\nm = Model()\n\n# Sum and domain constraints\nm += sum(steps) == n\nm += [(steps[i] >= m1) | (steps[i] == 0) for i in range(n)]\nm += [steps[i] <= m2 for i in range(n)]\nfor i in range(1, n):\n    m += (steps[i-1] == 0).implies(all(steps[j] == 0 for j in range(i, n)))\n\n# Weighted objective: 10 * (# of 5-step moves) - (# of moves)\nm.maximize(10*sum(steps[i] == m2 for i in range(n)) - sum(steps[i] != 0 for i in range(n)))\n\n# Solve and output\nif m.solve():\n    solution = {\"steps\": [s.value() for s in steps if s.value() != 0]}\n    print(json.dumps(solution))\n```"}}
// {"APLAI_EX5S2_objective_change_moderate": {"question": "We want to climb a stair of n steps with [m1, m2] steps at a time. For example a stair of 4 steps with m1 = 1, and m2 = 2 can be climbed with a sequence of four one-step moves or with two two-steps moves. Find a way to climb a stair of 20 steps with m1 = 3 and m2 = 5, i.e. you can take only 3 or 4 or 5 steps at a time.","existing_model": "```\nfrom cpmpy import *\nimport json\n\n# Parameters\nn = 20  # total number of steps in the stair\nm1, m2 = 3, 5  # number of steps that can be taken at a time\n\n# Decision variables\nsteps = intvar(0, m2, shape=n) # steps taken at each move\n\n# Model setup\nm = Model()\n\n# Constraint: the sum of steps should equal the total number of stairs\nm += sum(steps) == n\n\n# Constraint: the number of steps taken at each move should be between m1 and m2 or 0\nm += [(steps[i] >= m1) | (steps[i] == 0) for i in range(n)]\nm += [steps[i] <= m2 for i in range(n)]\n\n# Trailing zeros: If a step is 0, then all the following steps should be 0\nfor i in range(1, n):\n    m += (steps[i - 1] == 0).implies(all(steps[j] == 0 for j in range(i, n)))\n\n# Solve the model and print the results in the required format\nif m.solve():\n    solution = {\"steps\": [steps[i].value() for i in range(n) if steps[i].value() != 0]}\n    print(json.dumps(solution))\n```","modification_request": "Add an objective to maximize the number of largest step-size moves in the solution..","modified_cpmpy_code": "```\nfrom cpmpy import *\nimport json\n\n# Parameters\nn = 20\nm1, m2 = 3, 5\n\n# Decision variables\nsteps = intvar(0, m2, shape=n)\n\n# Model setup\nm = Model()\n\n# Sum and domain constraints as before\nm += sum(steps) == n\nm += [(steps[i] >= m1) | (steps[i] == 0) for i in range(n)]\nm += [steps[i] <= m2 for i in range(n)]\nfor i in range(1, n):\n    m += (steps[i-1] == 0).implies(all(steps[j] == 0 for j in range(i, n)))\n\n# New objective: maximize the count of 5-step moves\nm.maximize(sum(steps[i] == m2 for i in range(n)))\n\n# Solve and output\nif m.solve():\n    solution = {\"steps\": [s.value() for s in steps if s.value() != 0]}\n    print(json.dumps(solution))\n```"}}
// {"APLAI_EX5S2_objective_change_easy": {"question": "We want to climb a stair of n steps with [m1, m2] steps at a time. For example a stair of 4 steps with m1 = 1, and m2 = 2 can be climbed with a sequence of four one-step moves or with two two-steps moves. Find a way to climb a stair of 20 steps with m1 = 3 and m2 = 5, i.e. you can take only 3 or 4 or 5 steps at a time.","existing_model": "```\nfrom cpmpy import *\nimport json\n\n# Parameters\nn = 20  # total number of steps in the stair\nm1, m2 = 3, 5  # number of steps that can be taken at a time\n\n# Decision variables\nsteps = intvar(0, m2, shape=n) # steps taken at each move\n\n# Model setup\nm = Model()\n\n# Constraint: the sum of steps should equal the total number of stairs\nm += sum(steps) == n\n\n# Constraint: the number of steps taken at each move should be between m1 and m2 or 0\nm += [(steps[i] >= m1) | (steps[i] == 0) for i in range(n)]\nm += [steps[i] <= m2 for i in range(n)]\n\n# Trailing zeros: If a step is 0, then all the following steps should be 0\nfor i in range(1, n):\n    m += (steps[i - 1] == 0).implies(all(steps[j] == 0 for j in range(i, n)))\n\n# Solve the model and print the results in the required format\nif m.solve():\n    solution = {\"steps\": [steps[i].value() for i in range(n) if steps[i].value() != 0]}\n    print(json.dumps(solution))\n```","modification_request": "Add an objective to minimize the total number of non-zero steps.","modified_cpmpy_code": "```\nfrom cpmpy import *\nimport json\n\n# Parameters\nn = 20\nm1, m2 = 3, 5\n\n# Decision variables\nsteps = intvar(0, m2, shape=n)\n\n# Model setup\nm = Model()\n\n# Sum and domain constraints as before\nm += sum(steps) == n\nm += [(steps[i] >= m1) | (steps[i] == 0) for i in range(n)]\nm += [steps[i] <= m2 for i in range(n)]\nfor i in range(1, n):\n    m += (steps[i-1] == 0).implies(all(steps[j] == 0 for j in range(i, n)))\n\n# New objective: minimize the number of non-zero moves\nm.minimize(sum(steps[i] != 0 for i in range(n)))\n\n# Solve and output\nif m.solve():\n    solution = {\"steps\": [s.value() for s in steps if s.value() != 0]}\n    print(json.dumps(solution))\n```"}}
