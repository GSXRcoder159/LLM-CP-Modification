s for a2 in ages]\nm += [((a1==sammy)&(a2==moses_youth)).implies(age_to_int[a1]==age_to_int[a2]+3) for a1 in ages for a2 in ages]\n\nif m.solve():\n    sol={\"ages\":ages.value().tolist(),\"children\":children.value().tolist(),\"countries\":countries.value().tolist(),\"stories\":stories.value().tolist()}\n    print(json.dumps(sol))","modification_request": "Expand the domain of the 'children' variables from 1…5 to 1…6.","modified_cpmpy_code": "from cpmpy import *\nimport json\n\nage3, age5, age7, age8, age10 = ages = intvar(1, 5, shape=5)\n# children domain expanded\bernice, carl, debby, sammy, ted, extra = children = intvar(1, 6, shape=6)\nethiopia, kazakhstan, lithuania, morocco, yemen = countries = intvar(1, 5, shape=5)\nburning_bush, captivity, moses_youth, passover, ten_commandments = stories = intvar(1, 5, shape=5)\n\nm = Model()\nm += AllDifferent(ages)\nm += AllDifferent(children)\nm += AllDifferent(countries)\nm += AllDifferent(stories)\n\nm += debby == lithuania\nage_to_int={age3:3,age5:5,age7:7,age8:8,age10:10}\nm += [((a1==passover)&(a2==bernice)).implies(age_to_int[a1]==age_to_int[a2]+2) for a1 in ages for a2 in ages]\nm += [((a1==yemen)&(a2==ethiopia)).implies(age_to_int[a1]<age_to_int[a2]) for a1 in ages for a2 in ages]\nm += [((a1==morocco)&(a2==ted)).implies(age_to_int[a1]==age_to_int[a2]+3) for a1 in ages for a2 in ages]\nm += [((a1==sammy)&(a2==moses_youth)).implies(age_to_int[a1]==age_to_int[a2]+3) for a1 in ages for a2 in ages]\n\nif m.solve(): print(json.dumps({\"ages\":ages.value().tolist(),\"children\":children.value().tolist(),\"countries\":countries.value().tolist(),\"stories\":stories.value().tolist()}))"}}
// {"APLAI_EX1S6_Modification_Complex": {"question": "Alice has to give Bob change of 199 euros. She has 6 different types of coins of different value ([1, 2, 5, 10, 25, 50]) and she has a certain number of coins of each value available ([20, 10, 15, 8, 4, 2]). How can the change be composed with the available coins minimizing the number of coins used?","existing_model": "from cpmpy import *\nimport json\n\n# Data\namount = 199  # amount of money to give to Bob\nn = 6  # number of types of coins\ntypes_of_coins = [1, 2, 5, 10, 25, 50]  # value of each type of coin\navailable_coins = [20, 10, 15, 8, 4, 2]  # number of available coins of each type\n\n# Decision Variables\n# Create a variable for each type of coin, with each variable's domain set to [0, available_coins[i]]\ncoin_counts = [intvar(0, available_coins[i]) for i in range(n)]\n\n# Constraints\nm = Model()\n\n# The sum of the coins given to Bob must be equal to the amount of money to give him\nm += sum(coin_counts[i] * types_of_coins[i] for i in range(n)) == amount\n\n# Objective: Minimize the total number of coins given to Bob\nm.minimize(sum(coin_counts))\n\n# Solve the model and print the solution in the specified format\nif m.solve():\n    solution = {\"coin_counts\": [coin_counts[i].value() for i in range(n)]}\n    print(json.dumps(solution))", "modification_request": "Replace the existing constraints and bounds with a single global knapsack constraint","modified_cpmpy_code": "from cpmpy import *\nimport json\nfrom cpmpy.expressions.globalconstraints import knapsack\n\n# Data\namount = 199  # amount of money to give to Bob\nn = 6  # number of coin types\ntypes_of_coins = [1, 2, 5, 10, 25, 50]\navailable_coins = [20, 10, 15, 8, 4, 2]\n\n# Decision Variables\ncoin_counts = [intvar(0, available_coins[i]) for i in range(n)]\n\n# Model\ng = Model()\n# Global knapsack replaces both the sum == amount and x_i <= availability\ng += knapsack(\n    quantities=coin_counts,\n    weights=types_of_coins,\n    capacity=amount,\n    availability=available_coins\n)\n# Objective: Minimize the total face value of coins > 10 cents (25¢ & 50¢)\nhigh_value_indices = [4, 5]\ng.minimize(sum(coin_counts[i] * types_of_coins[i] for i in high_value_indices))\n\n# Solve and output\nif g.solve():\n    print(json.dumps({\"coin_counts\": [c.value() for c in coin_counts]}))"}}
// {"APLAI_EX1S6_Modification_Easy": {"question": "Alice has to give Bob change of 199 euros. She has 6 different types of coins of different value ([1, 2, 5, 10, 25, 50]) and she has a certain number of coins of each value available ([20, 10, 15, 8, 4, 2]). How can the change be composed with the available coins minimizing the number of coins used?","existing_model": "from cpmpy import *\nimport json\n\n# Data\namount = 199  # amount of money to give to Bob\nn = 6  # number of types of coins\ntypes_of_coins = [1, 2, 5, 10, 25, 50]  # value of each type of coin\navailable_coins = [20, 10, 15, 8, 4, 2]  # number of available coins of each type\n\n# Decision Variables\n# Create a variable for each type of coin, with each variable's domain set to [0, available_coins[i]]\ncoin_counts = [intvar(0, available_coins[i]) for i in range(n)]\n\n# Constraints\nm = Model()\n\n# The sum of the coins given to Bob must be equal to the amount of money to give him\nm += sum(coin_counts[i] * types_of_coins[i] for i in range(n)) == amount\n\n# Objective: Minimize the total number of coins given to Bob\nm.minimize(sum(coin_counts))\n\n# Solve the model and print the solution in the specified format\nif m.solve():\n    solution = {\"coin_counts\": [coin_counts[i].value() for i in range(n)]}\n    print(json.dumps(solution))", "modification_request": "Reduce the number of available 50 cent coins from 2 to 1.","modified_cpmpy_code": "from cpmpy import *\nimport json\n\n# Data\namount = 199  # amount of money to give to Bob\nn = 6  # number of types of coins\ntypes_of_coins = [1, 2, 5, 10, 25, 50]  # value of each type of coin\navailable_coins = [20, 10, 15, 8, 4, 1]  # number of available coins of each type\n\n# Decision Variables\n# Create a variable for each type of coin, with each variable's domain set to [0, available_coins[i]]\ncoin_counts = [intvar(0, available_coins[i]) for i in range(n)]\n\n# Constraints\nm = Model()\n\n# The sum of the coins given to Bob must be equal to the amount of money to give him\nm += sum(coin_counts[i] * types_of_coins[i] for i in range(n)) == amount\n\n# Objective: Minimize the total number of coins given to Bob\nm.minimize(sum(coin_counts))\n\n# Solve the model and print the solution in the specified format\nif m.solve():\n    solution = {\"coin_counts\": [coin_counts[i].value() for i in range(n)]}\n    print(json.dumps(solution))"}}
// {"APLAI_EX1S6_Modification_Moderate": {"question": "Alice has to give Bob change of 199 euros. She has 6 different types of coins of different value ([1, 2, 5, 10, 25, 50]) and she has a certain number of coins of each value available ([20, 10, 15, 8, 4, 2]). How can the change be composed with the available coins minimizing the number of coins used?","existing_model": "from cpmpy import *\nimport json\n\n# Data\namount = 199  # amount of money to give to Bob\nn = 6  # number of types of coins\ntypes_of_coins = [1, 2, 5, 10, 25, 50]  # value of each type of coin\navailable_coins = [20, 10, 15, 8, 4, 2]  # number of available coins of each type\n\n# Decision Variables\n# Create a variable for each type of coin, with each variable's domain set to [0, available_coins[i]]\ncoin_counts = [intvar(0, available_coins[i]) for i in range(n)]\n\n# Constraints\nm = Model()\n\n# The sum of the coins given to Bob must be equal to the amount of money to give him\nm += sum(coin_counts[i] * types_of_coins[i] for i in range(n)) == amount\n\n# Objective: Minimize the total number of coins given to Bob\nm.minimize(sum(coin_counts))\n\n# Solve the model and print the solution in the specified format\nif m.solve():\n    solution = {\"coin_counts\": [coin_counts[i].value() for i in range(n)]}\n    print(json.dumps(solution))","modification_request": "Change the objective from minimizing the number of coins to minimizing the total face value of coins above 10 cents used (i.e., 25 and 50 cent coins).","modified_cpmpy_code": "from cpmpy import *\nimport json\n\n# Data\namount = 199  # amount of money to give to Bob\nn = 6  # number of types of coins\ntypes_of_coins = [1, 2, 5, 10, 25, 50]  # value of each type of coin\navailable_coins = [20, 10, 15, 8, 4, 2]  # number of available coins of each type\n\n# Decision Variables\ncoin_counts = [intvar(0, available_coins[i]) for i in range(n)]\n\n# Constraints\nm = Model()\nm += sum(coin_counts[i] * types_of_coins[i] for i in range(n)) == amount\n\n# Objective: Minimize the total face value of coins > 10 cents (i.e., 25 and 50)\nhigh_value_indices = [4, 5]  # indices for 25 and 50 cent coins\nm.minimize(sum(coin_counts[i] * types_of_coins[i] for i in high_value_indices))\n\n# Solve the model and print the solution in the specified format\nif m.solve():\n    solution = {\"coin_counts\": [coin_counts[i].value() for i in range(n)]}\n    print(json.dumps(solution))"}}

// {"APLAI_EX1S6_ModifyConstraint": {"question": "Alice has to give Bob change of 199 euros. She has 6 different types of coins of different value ([1, 2, 5, 10, 25, 50]) and she has a certain number of coins of each value available ([20, 10, 15, 8, 4, 2]). How can the change be composed with the available coins minimizing the total face value of coins above 10 cents used?","existing_model": "from cpmpy import *\nimport json\n\n# Data\namount = 199  # amount of money to give to Bob\nn = 6  # number of types of coins\ntypes_of_coins = [1, 2, 5, 10, 25, 50]  # value of each type of coin\navailable_coins = [20, 10, 15, 8, 4, 2]  # number of available coins of each type\n\n# Decision Variables\n# Create a variable for each type of coin, with each variable's domain set to [0, available_coins[i]]\ncoin_counts = [intvar(0, available_coins[i]) for i in range(n)]\n\n# Constraints\nm = Model()\n\n# The sum of the coins given to Bob must be equal to the amount of money to give him\nm += sum(coin_counts[i] * types_of_coins[i] for i in range(n)) == amount\n\n# Objective: Minimize the total number of coins given to Bob\nm.minimize(sum(coin_counts))\n\n# Solve the model and print the solution in the specified format\nif m.solve():\n    solution = {\"coin_counts\": [coin_counts[i].value() for i in range(n)]}\n    print(json.dumps(solution))","modification_request": "Change the objective from minimizing the number of coins to minimizing the total face value of coins above 10 cents used (i.e., 25 and 50 cent coins).","modified_cpmpy_code": "from cpmpy import *\nimport json\n\n# Data\namount = 199  # amount of money to give to Bob\nn = 6  # number of types of coins\ntypes_of_coins = [1, 2, 5, 10, 25, 50]  # value of each type of coin\navailable_coins = [20, 10, 15, 8, 4, 2]  # number of available coins of each type\n\n# Decision Variables\ncoin_counts = [intvar(0, available_coins[i]) for i in range(n)]\n\n# Constraints\nm = Model()\nm += sum(coin_counts[i] * types_of_coins[i] for i in range(n)) == amount\n\n# Objective: Minimize the total face value of coins > 10 cents (i.e., 25 and 50)\nhigh_value_indices = [4, 5]  # indices for 25 and 50 cent coins\nm.minimize(sum(coin_counts[i] * types_of_coins[i] for i in high_value_indices))\n\n# Solve the model and print the solution in the specified format\nif m.solve():\n    solution = {\"coin_counts\": [coin_counts[i].value() for i in range(n)]}\n    print(json.dumps(solution))"}}
// {"APLAI_EX1S2_ModifyConstraint":{"question": "My bank card has a 4-digit PIN, abcd. I use the following facts to help me remember it:\n - No two digits are the same.\n - The 2-digit number cd is 3 times the 2-digit number ab.\n - The 2-digit number da is 2 times the 2-digit number bc.\nWhat is my PIN?","existing_model": "from cpmpy import *\nimport json\n\na, b, c, d = intvar(1, 9, shape=4)\n\nm = Model()\nm += AllDifferent([a, b, c, d])\nm += 10 * c + d == 3 * (10 * a + b)\nm += 10 * d + a == 2 * (10 * b + c)\n\nif m.solve():\n    solution = {'a': a.value(), 'b': b.value(), 'c': c.value(), 'd': d.value()}\n    print(json.dumps(solution))","modification_request": "Modify the constraint da = 2 * bc to da = bc.","modified_cpmpy_code": "from cpmpy import *\nimport json\n\na, b, c, d = intvar(1, 9, shape=4)\n\nm = Model()\nm += AllDifferent([a, b, c, d])\nm += 10 * c + d == 3 * (10 * a + b)\nm += 10 * d + a == 10 * b + c\n\nif m.solve():\n    solution = {'a': a.value(), 'b': b.value(), 'c': c.value(), 'd': d.value()}\n    print(json.dumps(solution))"}}
  